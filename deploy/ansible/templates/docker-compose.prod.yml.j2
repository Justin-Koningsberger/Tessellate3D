version: '3.8'

networks:
  slicer-network:
    driver: bridge

services:
  slicer-service:
    image: ghcr.io/{{ github_username }}/tessellate3d-slicer:latest
    container_name: tessellate3d-slicer-prod
    restart: unless-stopped
    environment:
      - NODE_ENV=production
      - PORT=3000
    volumes:
      - ./packages/slicer-service/certs:/app/packages/slicer-service/certs
    networks:
      - slicer-network

  caddy-proxy:
    image: caddy:2-alpine
    container_name: tessellate3d-caddy-proxy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - caddy_data:/data
      - caddy_config:/config
    networks:
      - slicer-network

volumes:
  caddy_data:
  caddy_config:
